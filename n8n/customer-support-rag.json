      "parameters": {
        "jsCode": "const request = $('Validate Input').first().json;\nconst search = $('Search Knowledge').first().json;\nreturn [{ json: { sessionId: request.sessionId, channel: request.channel, answer: '当前知识库没有足够信息支持这个问题。为了避免误导你，建议转人工客服进一步确认。', intent: 'unknown', citations: [], handoffRequired: true, handoffReason: '未检索到达到阈值的知识库内容。', retrievalThreshold: search.threshold ?? null } }];"
      },
