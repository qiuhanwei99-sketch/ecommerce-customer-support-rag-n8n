        "options": {}
      },
      "id": "call-ollama-chat",
      "name": "Ollama Chat Model",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "const promptData = $('Build Grounded Prompt').first().json;\nconst content = String($json.message?.content || $json.response || '').trim();\nconst lower = promptData.message.toLowerCase();\nconst handoff = /订单|地址|支付|退款争议|投诉|账户安全|密码|人工/.test(promptData.message);\nlet intent = 'general';\nif (/退货|换货/.test(promptData.message)) intent = 'return_policy';\nelse if (/退款/.test(promptData.message)) intent = 'refund_policy';\nelse if (/配送|发货|包邮|物流/.test(promptData.message)) intent = 'shipping_policy';\nelse if (/订单|地址/.test(promptData.message)) intent = 'order_service';\nelse if (/会员|积分/.test(promptData.message)) intent = 'membership';\nelse if (/商品|价格|功能|容量/.test(promptData.message)) intent = 'product_info';\nreturn [{ json: { sessionId: promptData.sessionId, channel: promptData.channel, answer: content || '本次模型没有返回可用答案，请转人工处理。', intent, citations: (promptData.search.results || []).map((item) => ({ source: item.source, section: item.section, chunkId: item.chunkId })), handoffRequired: handoff, handoffReason: handoff ? '该问题涉及订单、账户、支付或需要人工确认的操作。' : null, model: ($env.CHAT_MODEL || 'qwen3:4b'), retrievalThreshold: promptData.search.threshold } }];"
      },
      "id": "format-grounded-answer",
      "name": "Format Answer + Citations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        -120
